  "info": {
    "_postman_id": "a18041df-9e8b-4517-a7c6-c7fea93d4b8c",
    "name": "SMTP2GO SINGLE SENDER EMAILS API",
    "description": "The SMTP2GO v3 REST API for sending transactional email and SMS, managing sender domains and single sender emails, SMTP users, API keys, IP allow lists and IP auth, templates, webhooks, suppressions, subaccounts, dedicated IPs, email archive, activity search and delivery statistics. Every operation is a POST (with a PATCH variant on two paths) carrying a JSON body; authentication is an API key supplied in the X-Smtp2go-Api-Key header or as an api_key field in the request body.\n\nContact Support:\n Name: SMTP2GO Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T02:09:25.000Z",
    "updatedAt": "2026-10-22T02:09:25.000Z",
